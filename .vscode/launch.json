{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Eric's App (Hot-Reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.main:app",
                "--reload",
